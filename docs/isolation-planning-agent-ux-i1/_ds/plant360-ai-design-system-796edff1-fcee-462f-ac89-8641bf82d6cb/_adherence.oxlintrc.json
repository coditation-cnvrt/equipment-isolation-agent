      },
      {
        "selector": "JSXOpeningElement[name.name='InlineNotification'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:error|success|warning|info)$/]",
        "message": "<InlineNotification> kind must be one of 'error' | 'success' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|size|inline|disabled|renderIcon|children|className|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: href, size, inline, disabled, renderIcon, children, className."
